# Copy to tests/e2e/.env.e2e and fill in. Passwords must satisfy the Supabase password policy.
# All e2e users live on the E2E_EMAIL_DOMAIN domain; the seed only ever deletes users on that domain.
E2E_EMAIL_DOMAIN=e2e.evpos-test.dev
E2E_PASSWORD_OWNER=change-me-Owner1!
E2E_PASSWORD_BRANCH_MANAGER=change-me-Manager1!
E2E_PASSWORD_CASHIER=change-me-Cashier1!
E2E_PASSWORD_RECEIVABLES_STAFF=change-me-Recv1!
E2E_PASSWORD_NO_ACCESS_STAFF=change-me-NoAcc1!
# phase 2
E2E_PASSWORD_SUPPLIER_VIEWER=change-me-Supp1!
E2E_PASSWORD_DEPOSIT_STAFF_A=change-me-DepA1!
E2E_PASSWORD_DEPOSIT_STAFF_B=change-me-DepB1!
