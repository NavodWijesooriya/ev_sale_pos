generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. Platform & Tenant Management
// ==========================================

enum PlatformRole {
  PlatformAdmin
  Support
}

model PlatformUser {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  role         PlatformRole
  createdAt    DateTime     @default(now())
}

enum SubscriptionPlan {
  Free
  Basic
  Pro
  Enterprise
}

enum SubscriptionStatus {
  Active
  Suspended
}

model Organization {
  id                    String             @id @default(uuid())
  businessName          String
  domain                String?            @unique
  subdomain             String?            @unique
  phone                 String?
  logoUrl               String?
  subscriptionPlan      SubscriptionPlan   @default(Free)
  subscriptionStatus    SubscriptionStatus @default(Active)
  expiryDate            DateTime?
  staffCanManageCatalog Boolean            @default(false)
  createdAt             DateTime           @default(now())

  users              User[]
  branches           Branch[]
  suppliers          Supplier[]
  vehicleModels      VehicleModel[]
  vehicles           Vehicle[]
  grns               GRN[]
  customers          Customer[]
  sales              Sale[]
  financeCompanies   FinanceCompany[]
  insuranceCompanies InsuranceCompany[]
  advancePayments    AdvancePayment[]
  serviceRecords     ServiceRecord[]
  testRides          TestRide[]
  spareParts         SparePart[]
  serviceJobs        ServiceJob[]
  customDomain       String?            @unique
}

enum UserRole {
  OrgAdmin
  BranchManager
  SalesRep
  Cashier
  Technician
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  name           String
  email          String       @unique
  passwordHash   String
  role           UserRole
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  sales            Sale[]           @relation("SoldBy")
  commissionSales  Sale[]           @relation("CommissionRecipient")
  advancePayments  AdvancePayment[]
  assignedServices ServiceRecord[]  @relation("AssignedTechnician")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  location       String?
  contactNumber  String?
  createdAt      DateTime     @default(now())

  users           User[]
  vehicles        Vehicle[]
  grns            GRN[]
  sales           Sale[]
  advancePayments AdvancePayment[]
  serviceRecords  ServiceRecord[]
  testRides       TestRide[]
}

// ==========================================
// 2. Inventory & Procurement
// ==========================================

model Supplier {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactPerson  String?
  phone          String?
  email          String?

  grns GRN[]
}

model VehicleModel {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand           String
  modelName       String
  imageUrl        String?
  motorPower      String? // e.g., "2000W"
  batteryCapacity String? // e.g., "60V 32Ah"
  rangePerCharge  String? // e.g., "120km"
  range           String? // backward compatibility alias
  topSpeed        String? // e.g., "55 km/h"
  chargingTime    String? // e.g., "4-6 Hours"
  defaultPrice    Float
  minDownPayment  Float?

  vehicles  Vehicle[]
  testRides TestRide[]
}

enum VehicleStatus {
  AVAILABLE
  InStock
  Sold
  InTransit
  Reserved
}

model Vehicle {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  grnId          String?
  grn            GRN?         @relation(fields: [grnId], references: [id], onDelete: SetNull)
  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id])

  chassisNumber          String        @unique
  unitGrnNumber          String?       @unique
  motorNumber            String?
  chargingSerialNumber   String?
  batterySerialNumber    String?       @unique // අලුතින් එකතු කළ කොටස
  warrantyPeriod         String? // අලුතින් එකතු කළ කොටස (උදා: 3 Years)
  year                   Int?
  color                  String?
  status                 VehicleStatus @default(AVAILABLE)
  purchasePrice          Float
  freeServiceEntitlement Int           @default(0)
  freeServicesUsed       Int           @default(0)
  motorPower             String? // e.g., "2000W"
  batteryCapacity        String? // e.g., "60V 32Ah"
  rangePerCharge         String? // e.g., "120km"
  topSpeed               String? // e.g., "55 km/h"
  chargingTime           String? // e.g., "4-6 Hours"
  createdAt              DateTime      @default(now())

  grnItems       GRNItem[]
  saleItems      SaleItem[]
  sales          Sale[]           @relation("SaleVehicle")
  serviceRecords ServiceRecord[]
  advancePayments AdvancePayment[]
}

model GRN {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  supplierId     String?
  supplier       Supplier?    @relation(fields: [supplierId], references: [id])

  grnNumber          String   @unique
  date               DateTime @default(now())
  transportRefNumber String?
  orderNumber        String?
  transportCost      Float?
  totalAmount        Float    @default(0)
  receivedDate       DateTime @default(now())

  items    GRNItem[]
  payments Payment[]
  vehicles Vehicle[]

  @@index([organizationId, date])
}

model GRNItem {
  id        String  @id @default(uuid())
  grnId     String
  grn       GRN     @relation(fields: [grnId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  unitPrice Float
}

// ==========================================
// 3. Sales, Finance, Customers & DMT
// ==========================================

model Customer {
  id                  String           @id @default(uuid())
  organizationId      String
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category            CustomerCategory @default(CRM)
  customerType        CustomerType     @default(CRM)
  name                String
  phone               String
  email               String?
  nic                 String?
  address             String?
  crn                 String?          @unique
  title               String?
  city                String?
  interestedModel     String?
  quantity            Int              @default(1)
  testRide            Boolean          @default(false)
  leadSource          String?
  socialMediaPlatform String?
  websiteSource       String?
  firstCallNote       String?          @db.Text
  secondCallNote      String?          @db.Text
  thirdCallNote       String?          @db.Text
  fourthCallNote      String?          @db.Text

  sales                    Sale[]
  advancePayments          AdvancePayment[]
  advanceTransfersReceived AdvanceTransfer[] @relation("AdvanceTransferToCustomer")
  serviceRecords           ServiceRecord[]
  testRides                TestRide[]
}

enum CustomerCategory {
  DIRECT
  CRM
}

enum CustomerType {
  CRM
  SALE
}

enum PaymentMethod {
  Cash
  Card
  BankTransfer
  Finance
  SplitPayment
  CHEQUE
}

enum ChequeStatus {
  PENDING
  CLEARED
  BOUNCED
}

enum PaymentStatus {
  Pending
  Paid
  PartiallyPaid
}

enum TestRideStatus {
  BOOKED
  COMPLETED
  CANCELLED
}

enum NumberPlateStatus {
  PENDING
  PROCESSING
  ISSUED
}

enum AdvancePaymentStatus {
  PENDING
  USED
  REFUNDED
  TRANSFERRED
}

model Sale {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  userId         String
  soldBy         User         @relation("SoldBy", fields: [userId], references: [id])

  saleDate            DateTime          @default(now())
  invoiceNumber       String            @unique
  vehicleId           String
  vehicle             Vehicle           @relation("SaleVehicle", fields: [vehicleId], references: [id])
  advancePaymentId    String?           @unique
  advancePayment      AdvancePayment?   @relation(fields: [advancePaymentId], references: [id])
  financeCompanyId    String?
  financeCompany      FinanceCompany?   @relation("SaleFinanceCompany", fields: [financeCompanyId], references: [id], onDelete: SetNull)
  insuranceCompanyId  String?
  insuranceCompany    InsuranceCompany? @relation("SaleInsuranceCompany", fields: [insuranceCompanyId], references: [id], onDelete: SetNull)
  paymentType              String?           @default("CASH") // CASH or FINANCE
  commissionAmount         Float?            @default(0)
  totalAmount              Float
  discount                 Float             @default(0) // අලුතින් එකතු කළ කොටස
  additionalCharges        Float             @default(0) // අලුතින් එකතු කළ කොටස
  advanceDeducted          Float             @default(0) // Amount deducted from advance payment at checkout
  financeCommission        Float?
  insuranceCommission      Float?
  commissionRecipientId    String?           // Staff member credited with finance commission
  commissionRecipient      User?             @relation("CommissionRecipient", fields: [commissionRecipientId], references: [id], onDelete: SetNull)
  deliveryDate             DateTime?         // අලුතින් එකතු කළ කොටස
  paymentMethod            String?
  warrantyOption           String?
  status                   String            @default("Completed")
  freeItems                String[]          @default([])
  freeServices             Int               @default(0)

  items           SaleItem[]
  financeDetail   FinanceDetail?
  dmtRegistration DMTRegistration? // අලුතින් එකතු කළ කොටස
  payments        Payment[]

  @@index([organizationId, financeCompanyId])
  @@index([organizationId, insuranceCompanyId])
  @@index([commissionRecipientId])
}

model FinanceCompany {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  contactNo             String
  defaultCommissionRate Float?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  sales    Sale[]           @relation("SaleFinanceCompany")
  officers FinanceOfficer[]

  @@unique([organizationId, name])
}

model FinanceOfficer {
  id               String         @id @default(uuid())
  name             String
  contactNo        String
  financeCompanyId String
  financeCompany   FinanceCompany @relation(fields: [financeCompanyId], references: [id], onDelete: Cascade)

  @@index([financeCompanyId])
}

model InsuranceCompany {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  contactNo             String
  defaultCommissionRate Float?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  sales    Sale[]             @relation("SaleInsuranceCompany")
  officers InsuranceOfficer[]

  @@unique([organizationId, name])
}

model InsuranceOfficer {
  id                 String           @id @default(uuid())
  name               String
  contactNo          String
  insuranceCompanyId String
  insuranceCompany   InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id], onDelete: Cascade)

  @@index([insuranceCompanyId])
}

model AdvancePayment {
  id             String               @id @default(uuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer             @relation(fields: [customerId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  nicNumber      String
  bikeModel      String
  amount         Float
  advanceDate    DateTime             @default(now())
  createdAt      DateTime             @default(now())
  paymentMethod  String?              @default("Cash")
  notes          String?              @db.Text
  branchId       String
  branch         Branch               @relation(fields: [branchId], references: [id])
  staffId        String
  staff          User                 @relation(fields: [staffId], references: [id])
  paymentDetails String
  status         AdvancePaymentStatus @default(PENDING)

  sale      Sale?
  refunds   AdvanceRefund[]
  transfers AdvanceTransfer[] @relation("AdvanceTransferFrom")

  @@index([organizationId, status])
  @@index([customerId, status])
  @@index([vehicleId])
}

model AdvanceRefund {
  id            String         @id @default(uuid())
  advanceId     String
  advance       AdvancePayment @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  refundDate    DateTime       @default(now())
  refundAmount  Float
  paymentMethod String
  status        String

  @@index([advanceId, refundDate])
}

model AdvanceTransfer {
  id             String         @id @default(uuid())
  fromAdvanceId  String
  fromAdvance    AdvancePayment @relation("AdvanceTransferFrom", fields: [fromAdvanceId], references: [id], onDelete: Cascade)
  toCustomerId   String
  toCustomer     Customer       @relation("AdvanceTransferToCustomer", fields: [toCustomerId], references: [id])
  transferAmount Float
  transferDate   DateTime       @default(now())

  @@index([fromAdvanceId, transferDate])
  @@index([toCustomerId, transferDate])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  price     Float
}

enum FinanceStatus {
  Pending
  Received
}

model FinanceDetail {
  id                 String        @id @default(uuid())
  saleId             String        @unique
  sale               Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  financeCompany     String
  totalFinanceAmount Float
  downPaymentPaid    Float
  dealerCommission   Float?
  status             FinanceStatus @default(Pending)
}

enum DMTStatus {
  Pending
  DocumentsCollected
  Processing
  Completed
}

// අලුතින් එකතු කළ DMT Tracking Model එක
model DMTRegistration {
  id                String            @id @default(uuid())
  saleId            String            @unique
  sale              Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  status            DMTStatus         @default(Pending)
  hasMTA2           Boolean           @default(false)
  hasNIC            Boolean           @default(false)
  hasPhotos         Boolean           @default(false)
  hasTIN            Boolean           @default(false)
  registeredNumber  String?
  numberPlateStatus NumberPlateStatus @default(PENDING)
}

// ==========================================
// 4. After-Sales & Services
// ==========================================

enum ServiceType {
  Free
  Paid
  Warranty
}

model ServiceRecord {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId             String
  branch               Branch       @relation(fields: [branchId], references: [id])
  vehicleId            String
  vehicle              Vehicle      @relation(fields: [vehicleId], references: [id])
  customerId           String
  customer             Customer     @relation(fields: [customerId], references: [id])
  assignedTechnicianId String?
  assignedTechnician   User?        @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)

  serviceDate        DateTime    @default(now())
  inDate             DateTime    @default(now())
  outDate            DateTime?
  inMileage          String?
  nextServiceMileage String?
  serviceType        ServiceType
  description        String?
  totalCost          Float       @default(0)
  status             String      @default("PENDING")
  createdAt          DateTime    @default(now())
  serviceJob         ServiceJob?
}

model SparePart {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sku            String
  partNumber     String?
  price          Float
  stockQuantity  Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  serviceParts ServicePart[]

  @@unique([organizationId, sku])
  @@index([organizationId, name])
}

model ServiceJob {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceRecordId String        @unique
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)
  status          String        @default("COMPLETED")
  partsCost       Float         @default(0)
  totalCost       Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  parts ServicePart[]

  @@index([organizationId, createdAt])
}

model ServicePart {
  id           String     @id @default(uuid())
  serviceJobId String
  serviceJob   ServiceJob @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  sparePartId  String
  sparePart    SparePart  @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  quantity     Int
  unitPrice    Float
  totalPrice   Float
  createdAt    DateTime   @default(now())

  @@unique([serviceJobId, sparePartId])
  @@index([sparePartId])
}

model Payment {
  id            String         @id @default(uuid())
  saleId        String?
  sale          Sale?          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  grnId         String?
  grn           GRN?           @relation(fields: [grnId], references: [id], onDelete: Cascade)
  amount        Float
  paymentMethod PaymentMethod?
  chequeNumber  String?
  bankName      String?
  chequeDate    DateTime?
  dueDate       DateTime?
  chequeStatus  ChequeStatus?
  status        PaymentStatus  @default(Pending)
  createdAt     DateTime       @default(now())
}

model TestRide {
  id             String         @id @default(uuid())
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleModelId String
  vehicleModel   VehicleModel   @relation(fields: [vehicleModelId], references: [id])
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch         @relation(fields: [branchId], references: [id])
  scheduledDate  DateTime
  timeSlot       String
  status         TestRideStatus @default(BOOKED)
  createdAt      DateTime       @default(now())

  @@index([organizationId, scheduledDate])
  @@index([branchId, scheduledDate])
}
