generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. Platform & Tenant Management
// ==========================================

enum PlatformRole {
  PlatformAdmin
  Support
}

model PlatformUser {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  role         PlatformRole
  createdAt    DateTime     @default(now())
}

enum SubscriptionPlan {
  Free
  Basic
  Pro
  Enterprise
}

enum SubscriptionStatus {
  Active
  Suspended
}

model Organization {
  id                    String             @id @default(uuid())
  businessName          String
  domain                String?            @unique
  subdomain             String?            @unique
  phone                 String?
  logoUrl               String?
  subscriptionPlan      SubscriptionPlan   @default(Free)
  subscriptionStatus    SubscriptionStatus @default(Active)
  expiryDate            DateTime?
  staffCanManageCatalog Boolean            @default(false)
  createdAt             DateTime           @default(now())

  users                      User[]
  branches                   Branch[]
  suppliers                  Supplier[]
  vehicleModels              VehicleModel[]
  vehicles                   Vehicle[]
  grns                       GRN[]
  supplierPayments           SupplierPayment[]
  cheques                    Cheque[]
  supplierAdvances           SupplierAdvance[]
  customers                  Customer[]
  sales                      Sale[]
  financeCompanies           FinanceCompany[]
  insuranceCompanies         InsuranceCompany[]
  advancePayments            AdvancePayment[]
  serviceRecords             ServiceRecord[]
  testRides                  TestRide[]
  spareParts                 SparePart[]
  serviceJobs                ServiceJob[]
  auditLogs                  AuditLog[]
  commissionSettings         CommissionSettings?
  commissionSettlements      CommissionSettlement[]
  financeReceipts            FinanceReceipt[]
  incomingCheques            IncomingCheque[]
  bankAccounts               BankAccount[]
  bankDeposits               BankDeposit[]
  stockTransfers             StockTransfer[]
  customDomain               String?                     @unique
  freeItems                  FreeItem[]
  companyOffices             CompanyOffice[]
  ownershipTransfers         VehicleOwnershipTransfer[]
  supplierCommissionSlabs    SupplierCommissionSlab[]
  supplierMonthlyTargets     SupplierMonthlyTarget[]
  supplierCommissionMonths   SupplierCommissionMonth[]
  supplierCommissionReceipts SupplierCommissionReceipt[]
  deliveryOrders             DeliveryOrder[]
}

// Owner-configured commission rules. Finance rates live on FinanceCompany.defaultCommissionRate.
model CommissionSettings {
  organizationId            String       @id
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Fixed dealer commission (LKR) for Full Insurance issued through the dealership on a cash sale.
  fullInsuranceCommission   Float        @default(2000)
  // Customer-paid charges added to every NEW sale (each sale snapshots the amounts it was made with).
  rmvChargeFinance          Float        @default(14300) // RMV charge (LKR) on Finance sales
  rmvChargeCash             Float        @default(10300) // RMV charge (LKR) on Cash sales
  thirdPartyInsuranceAmount Float        @default(1200) // Third-party insurance (LKR), added when the box is ticked
  updatedAt                 DateTime     @updatedAt
  updatedById               String?
}

// Append-only record of critical staff actions. Viewable by the owner only.
model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String? // acting user (kept as plain text so history survives user deletion)
  userName       String
  branchId       String?
  action         String // e.g. SALE_CREATED, SUPPLIER_PAYMENT_RECORDED
  entityType     String // e.g. Sale, GRN, SupplierPayment, Cheque, User
  entityId       String?
  description    String
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([organizationId, userId])
}

enum UserRole {
  OrgAdmin
  BranchManager
  SalesRep
  Cashier
  Technician
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  name           String
  email          String       @unique
  passwordHash   String
  role           UserRole
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  // Fine-grained permission keys (see lib/permissions.ts). OrgAdmin/SuperAdmin ignore this and have all.
  permissions    String[]     @default([])

  sales            Sale[]           @relation("SoldBy")
  commissionSales  Sale[]           @relation("CommissionRecipient")
  advancePayments  AdvancePayment[]
  assignedServices ServiceRecord[]  @relation("AssignedTechnician")

  // What this staff member earns (salary + commissions). Owner-only data.
  compensations   StaffCompensation[]
  saleCommissions StaffSaleCommission[]
}

// Staff pay settings, one row per change with the day it starts applying (Colombo day start).
// The rates in force on a sale's date are the latest row with effectiveFrom <= that date,
// so changing a rate never touches commissions already earned.
model StaffCompensation {
  id                     String   @id @default(uuid())
  organizationId         String
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  effectiveFrom          DateTime
  basicSalary            Float    @default(0) // LKR per month
  saleCommissionType     String   @default("FIXED") // FIXED (LKR per bike) or PERCENT (% of bike price)
  saleCommissionValue    Float    @default(0)
  financeCommissionType  String   @default("FIXED") // FIXED (LKR per finance sale) or PERCENT (% of finance amount)
  financeCommissionValue Float    @default(0)
  createdById            String?
  createdAt              DateTime @default(now())

  @@unique([userId, effectiveFrom])
  @@index([organizationId, userId])
}

// What a staff member earned on one sale, frozen with the rates used. This is the STAFF member's earning,
// separate from the dealership's own finance / insurance commission (CommissionSettlement).
model StaffSaleCommission {
  id                     String    @id @default(uuid())
  organizationId         String
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  saleId                 String    @unique
  sale                   Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleDate               DateTime
  saleCommission         Float     @default(0)
  financeCommission      Float     @default(0)
  // Rates and amounts the figures were worked out from
  bikePrice              Float     @default(0)
  financeAmount          Float     @default(0)
  saleCommissionType     String    @default("FIXED")
  saleCommissionValue    Float     @default(0)
  financeCommissionType  String    @default("FIXED")
  financeCommissionValue Float     @default(0)
  source                 String    @default("SALE") // SALE (earned when the sale was made) or RECALCULATED (owner)
  status                 String    @default("ACTIVE") // ACTIVE or VOIDED
  voidedAt               DateTime?
  voidReason             String?
  createdAt              DateTime  @default(now())

  @@index([organizationId, userId, saleDate])
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  location       String?
  contactNumber  String?
  createdAt      DateTime     @default(now())

  users            User[]
  vehicles         Vehicle[]
  grns             GRN[]
  supplierPayments SupplierPayment[]
  financeReceipts  FinanceReceipt[]
  bankDeposits     BankDeposit[]
  sales            Sale[]
  advancePayments  AdvancePayment[]
  serviceRecords   ServiceRecord[]
  testRides        TestRide[]
  transfersOut     StockTransfer[]   @relation("StockTransferFrom")
  transfersIn      StockTransfer[]   @relation("StockTransferTo")
}

// ==========================================
// 2. Inventory & Procurement
// ==========================================

model Supplier {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactPerson  String?
  phone          String?
  email          String?

  grns           GRN[]
  payments       SupplierPayment[]
  cheques        Cheque[]
  advances       SupplierAdvance[]
  monthlyTargets SupplierMonthlyTarget[]
}

model VehicleModel {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand           String
  modelName       String
  imageUrl        String?
  motorPower      String? // e.g., "2000W"
  batteryCapacity String? // e.g., "60V 32Ah"
  rangePerCharge  String? // e.g., "120km"
  range           String? // backward compatibility alias
  topSpeed        String? // e.g., "55 km/h"
  chargingTime    String? // e.g., "4-6 Hours"
  defaultPrice    Float
  minDownPayment  Float?

  vehicles        Vehicle[]
  advancePayments AdvancePayment[]
  testRides       TestRide[]
}

enum VehicleStatus {
  AVAILABLE // in stock; the only "in stock" status (the legacy InStock value was merged into it)
  Sold
  InTransit
  Reserved
}

model Vehicle {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  grnId          String?
  grn            GRN?         @relation(fields: [grnId], references: [id], onDelete: SetNull)
  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id])

  chassisNumber          String        @unique
  unitGrnNumber          String?
  registrationNumber     String? // Actual bike license plate number once assigned (e.g. WP BHE-1234)
  motorNumber            String?
  chargingSerialNumber   String?
  batterySerialNumber    String?       @unique // අලුතින් එකතු කළ කොටස
  warrantyPeriod         String? // අලුතින් එකතු කළ කොටස (උදා: 3 Years)
  year                   Int?
  color                  String?
  status                 VehicleStatus @default(AVAILABLE)
  purchasePrice          Float
  freeServiceEntitlement Int           @default(0)
  freeServicesUsed       Int           @default(0)
  motorPower             String? // e.g., "2000W"
  batteryCapacity        String? // e.g., "60V 32Ah"
  rangePerCharge         String? // e.g., "120km"
  topSpeed               String? // e.g., "55 km/h"
  chargingTime           String? // e.g., "4-6 Hours"
  createdAt              DateTime      @default(now())

  grnItems           GRNItem[]
  saleItems          SaleItem[]
  sales              Sale[]                     @relation("SaleVehicle")
  serviceRecords     ServiceRecord[]
  advancePayments    AdvancePayment[]
  transferItems      StockTransferItem[]
  ownershipTransfers VehicleOwnershipTransfer[]

  // Unit numbers (JM0101 ...) derive from the dealership's batch number, so they are unique per dealership.
  @@unique([organizationId, unitGrnNumber])
  @@index([organizationId, status])
}

model GRN {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  supplierId     String?
  supplier       Supplier?    @relation(fields: [supplierId], references: [id])

  grnNumber          String
  date               DateTime @default(now())
  transportRefNumber String?
  orderNumber        String?
  transportCost      Float?
  totalAmount        Float    @default(0)
  receivedDate       DateTime @default(now())

  // Supplier payment tracking (totalAmount = amount owed to supplier)
  paidAmount    Float            @default(0)
  balanceAmount Float            @default(0)
  paymentStatus GrnPaymentStatus @default(UNPAID)

  items              GRNItem[]
  payments           Payment[]
  vehicles           Vehicle[]
  paymentAllocations SupplierPaymentAllocation[]
  advanceAllocations SupplierAdvanceAllocation[]

  // Batch numbers (JM 01, JM 02 ...) run per dealership, so they only need to be unique within one.
  @@unique([organizationId, grnNumber])
  @@index([organizationId, date])
  @@index([supplierId, paymentStatus])
}

enum GrnPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum SupplierPaymentStatus {
  COMPLETED // cash / bank transfer, or cheque that has cleared
  PENDING // cheque issued, not yet cleared
  REVERSED // cheque bounced or payment voided; allocations reversed
}

// A single payment made to a supplier. One payment can be allocated across
// many GRNs (see SupplierPaymentAllocation) and/or leave an advance.
model SupplierPayment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id])

  paymentNumber String
  amount        Float
  method        PaymentMethod // Cash | BankTransfer | CHEQUE are used for supplier payments
  status        SupplierPaymentStatus @default(COMPLETED)
  paymentDate   DateTime              @default(now())
  referenceNo   String? // bank transfer reference
  notes         String?
  createdById   String?
  createdAt     DateTime              @default(now())
  reversedAt    DateTime?

  cheque      Cheque?
  allocations SupplierPaymentAllocation[]
  advances    SupplierAdvance[]

  // Numbers run per dealership (SP-00001 ...), so uniqueness is per organization, not global.
  @@unique([organizationId, paymentNumber])
  @@index([organizationId, paymentDate])
  @@index([supplierId])
}

// How much of a payment was applied to a given GRN.
model SupplierPaymentAllocation {
  id        String          @id @default(uuid())
  paymentId String
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  grnId     String
  grn       GRN             @relation(fields: [grnId], references: [id])
  amount    Float
  createdAt DateTime        @default(now())

  @@index([paymentId])
  @@index([grnId])
}

// Cheque issued to a supplier. Created together with a CHEQUE SupplierPayment.
model Cheque {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  paymentId      String          @unique
  payment        SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  chequeNumber String
  bankName     String
  amount       Float
  chequeDate   DateTime // date written on the cheque (may be post-dated)
  status       ChequeStatus @default(ISSUED)
  clearedAt    DateTime?
  bouncedAt    DateTime?
  bounceReason String?
  createdAt    DateTime     @default(now())

  events ChequeEvent[]

  @@index([organizationId, status])
  @@index([supplierId])
}

// Append-only audit trail of every cheque status change.
model ChequeEvent {
  id         String        @id @default(uuid())
  chequeId   String
  cheque     Cheque        @relation(fields: [chequeId], references: [id], onDelete: Cascade)
  fromStatus ChequeStatus?
  toStatus   ChequeStatus
  note       String?
  userId     String?
  createdAt  DateTime      @default(now())

  @@index([chequeId])
}

// Money paid to a supplier ahead of any GRN (or overpayment). Consumed by
// allocating it to GRNs via SupplierAdvanceAllocation.
model SupplierAdvance {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier         @relation(fields: [supplierId], references: [id])
  paymentId      String? // payment that funded this advance
  payment        SupplierPayment? @relation(fields: [paymentId], references: [id])

  amount        Float
  usedAmount    Float    @default(0)
  balanceAmount Float
  date          DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  allocations SupplierAdvanceAllocation[]

  @@index([supplierId])
}

model SupplierAdvanceAllocation {
  id        String          @id @default(uuid())
  advanceId String
  advance   SupplierAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  grnId     String
  grn       GRN             @relation(fields: [grnId], references: [id])
  amount    Float
  createdAt DateTime        @default(now())

  @@index([advanceId])
  @@index([grnId])
}

model GRNItem {
  id        String  @id @default(uuid())
  grnId     String
  grn       GRN     @relation(fields: [grnId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  unitPrice Float
}

// ==========================================
// 3. Sales, Finance, Customers & DMT
// ==========================================

model Customer {
  id                  String           @id @default(uuid())
  organizationId      String
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category            CustomerCategory @default(CRM)
  customerType        CustomerType     @default(CRM)
  name                String
  phone               String
  email               String?
  nic                 String? // normalised: no spaces, upper-case; unique per organization when set
  tinNumber           String? // optional TIN, offered as the default on new sales and advances
  address             String?
  crn                 String?          @unique
  title               String?
  city                String?
  interestedModel     String?
  quantity            Int              @default(1)
  testRide            Boolean          @default(false)
  leadSource          String?
  socialMediaPlatform String?
  websiteSource       String?
  firstCallNote       String?          @db.Text
  secondCallNote      String?          @db.Text
  thirdCallNote       String?          @db.Text
  fourthCallNote      String?          @db.Text

  sales                    Sale[]
  advancePayments          AdvancePayment[]
  advanceTransfersReceived AdvanceTransfer[]          @relation("AdvanceTransferToCustomer")
  serviceRecords           ServiceRecord[]
  testRides                TestRide[]
  transfersFrom            VehicleOwnershipTransfer[] @relation("OwnershipTransferFrom")
  transfersTo              VehicleOwnershipTransfer[] @relation("OwnershipTransferTo")
  dmtOwned                 DMTRegistration[]          @relation("DmtOwner")

  // A NIC identifies one customer per dealership (NULL stays allowed many times).
  @@unique([organizationId, nic])
}

enum CustomerCategory {
  DIRECT
  CRM
}

enum CustomerType {
  CRM
  SALE
}

enum PaymentMethod {
  Cash
  Card
  BankTransfer
  Finance
  SplitPayment
  CHEQUE
}

// How the customer's vehicle insurance is arranged at sale time.
enum InsuranceType {
  NONE
  FULL_DEALER // comprehensive cover issued through the dealership
  CUSTOMER_OWN // customer arranges their own policy ("Customer Pitin")
}

enum ChequeStatus {
  PENDING // legacy: treated the same as ISSUED
  ISSUED
  PRESENTED
  CLEARED
  BOUNCED
  CANCELLED
}

enum PaymentStatus {
  Pending
  Paid
  PartiallyPaid
}

enum TestRideStatus {
  BOOKED
  COMPLETED
  CANCELLED
}

enum NumberPlateStatus {
  PENDING
  PROCESSING
  ISSUED
}

enum AdvancePaymentStatus {
  PENDING
  USED
  REFUNDED
  TRANSFERRED
}

model Sale {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  userId         String
  soldBy         User         @relation("SoldBy", fields: [userId], references: [id])

  saleDate              DateTime               @default(now())
  invoiceNumber         String                 @unique
  vehicleId             String
  vehicle               Vehicle                @relation("SaleVehicle", fields: [vehicleId], references: [id])
  advancePaymentId      String?                @unique
  advancePayment        AdvancePayment?        @relation(fields: [advancePaymentId], references: [id])
  financeCompanyId      String?
  financeCompany        FinanceCompany?        @relation("SaleFinanceCompany", fields: [financeCompanyId], references: [id], onDelete: SetNull)
  insuranceCompanyId    String?
  insuranceCompany      InsuranceCompany?      @relation("SaleInsuranceCompany", fields: [insuranceCompanyId], references: [id], onDelete: SetNull)
  paymentType           String?                @default("CASH") // CASH or FINANCE
  financeAmount         Float                  @default(0) // The loan amount provided by the finance company
  downPayment           Float                  @default(0) // The cash down payment paid by the customer
  commissionBasis       String                 @default("FINANCE_AMOUNT") // "FINANCE_AMOUNT", "VEHICLE_PRICE", or "FIXED"
  commissionRate        Float                  @default(0) // percentage or fixed multiplier
  commissionAmount      Float                  @default(0) // final calculated or manually overridden commission value in LKR
  totalAmount           Float
  discount              Float                  @default(0) // අලුතින් එකතු කළ කොටස
  additionalCharges     Float                  @default(0) // අලුතින් එකතු කළ කොටස
  // Customer-paid charges added at sale time, saved separately from the bike price (snapshot of the owner settings then).
  rmvCharge             Float                  @default(0)
  thirdPartyInsurance   Float                  @default(0)
  tinNumber             String? // optional customer TIN, printed on the invoice
  advanceDeducted       Float                  @default(0) // Amount deducted from advance payment at checkout
  financeCommission     Float?
  insuranceCommission   Float?
  insuranceType         InsuranceType          @default(NONE)
  commissionSettlements CommissionSettlement[]
  commissionRecipientId String? // Staff member credited with finance commission
  commissionRecipient   User?                  @relation("CommissionRecipient", fields: [commissionRecipientId], references: [id], onDelete: SetNull)
  deliveryDate          DateTime? // අලුතින් එකතු කළ කොටස
  // Explicit "bike handed over to the customer" record (all sales). A finance sale needs its Delivery Order first.
  deliveredAt           DateTime?
  deliveredByName       String?
  paymentMethod         String?
  warrantyOption        String?
  status                String                 @default("Completed") // Completed or CANCELLED (see lib/sale-status.ts)
  freeItems             String[]               @default([])
  freeServices          Int                    @default(0)

  items           SaleItem[]
  financeDetail   FinanceDetail?
  dmtRegistration DMTRegistration? // අලුතින් එකතු කළ කොටස
  payments        Payment[]
  freeItemLinks   SaleFreeItem[]
  staffCommission StaffSaleCommission?
  deliveryOrder   DeliveryOrder?

  // Cancellation (void / customer return). The sale is never deleted: it stays with status CANCELLED.
  cancelledAt           DateTime?
  cancelledById         String? // plain text so the history survives staff deletion
  cancelledByName       String?
  cancelType            String? // MISTAKE ("Entered by mistake") or RETURNED ("Customer returned the bike")
  cancelReason          String?
  cancelRefundAmount    Float     @default(0) // money handed back to the customer on cancellation
  cancelRefundMethod    String? // Cash, BankTransfer or CHEQUE
  cancelAdvanceReleased Float     @default(0) // customer advance that went back to PENDING

  // Finance / insurance company office chosen for this sale (name kept as it was)
  financeOfficeId     String?
  financeOffice       CompanyOffice? @relation("SaleFinanceOffice", fields: [financeOfficeId], references: [id], onDelete: SetNull)
  financeOfficeName   String?
  insuranceOfficeId   String?
  insuranceOffice     CompanyOffice? @relation("SaleInsuranceOffice", fields: [insuranceOfficeId], references: [id], onDelete: SetNull)
  insuranceOfficeName String?

  @@index([organizationId, financeCompanyId])
  @@index([organizationId, insuranceCompanyId])
  @@index([commissionRecipientId])
  @@index([organizationId, status])
}

model FinanceCompany {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  contactNo             String
  headOfficeAddress     String?
  defaultCommissionRate Float?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  sales    Sale[]           @relation("SaleFinanceCompany")
  officers FinanceOfficer[]
  offices  CompanyOffice[]

  financeDetails  FinanceDetail[]
  receipts        FinanceReceipt[]
  incomingCheques IncomingCheque[]

  @@unique([organizationId, name])
}

model FinanceOfficer {
  id               String         @id @default(uuid())
  name             String
  contactNo        String
  financeCompanyId String
  financeCompany   FinanceCompany @relation(fields: [financeCompanyId], references: [id], onDelete: Cascade)

  @@index([financeCompanyId])
}

model InsuranceCompany {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  contactNo             String
  headOfficeAddress     String?
  defaultCommissionRate Float?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  sales    Sale[]             @relation("SaleInsuranceCompany")
  officers InsuranceOfficer[]
  offices  CompanyOffice[]

  @@unique([organizationId, name])
}

model InsuranceOfficer {
  id                 String           @id @default(uuid())
  name               String
  contactNo          String
  insuranceCompanyId String
  insuranceCompany   InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id], onDelete: Cascade)

  @@index([insuranceCompanyId])
}

model AdvancePayment {
  id             String               @id @default(uuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer             @relation(fields: [customerId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  // Bike model booked when no specific bike is in stock yet; the bike is linked (vehicleId) when the sale is made
  vehicleModelId String?
  vehicleModel   VehicleModel?        @relation(fields: [vehicleModelId], references: [id], onDelete: SetNull)
  nicNumber      String
  tinNumber      String? // optional customer TIN, carried into the sale when the advance is used
  bikeModel      String
  amount         Float
  advanceDate    DateTime             @default(now())
  createdAt      DateTime             @default(now())
  paymentMethod  String?              @default("Cash")
  notes          String?              @db.Text
  branchId       String
  branch         Branch               @relation(fields: [branchId], references: [id])
  staffId        String
  staff          User                 @relation(fields: [staffId], references: [id])
  paymentDetails String
  status         AdvancePaymentStatus @default(PENDING)

  sale      Sale?
  refunds   AdvanceRefund[]
  transfers AdvanceTransfer[] @relation("AdvanceTransferFrom")

  @@index([organizationId, status])
  @@index([customerId, status])
  @@index([vehicleId])
  @@index([vehicleModelId])
}

model AdvanceRefund {
  id            String         @id @default(uuid())
  advanceId     String
  advance       AdvancePayment @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  refundDate    DateTime       @default(now())
  refundAmount  Float
  paymentMethod String
  status        String

  @@index([advanceId, refundDate])
}

model AdvanceTransfer {
  id             String         @id @default(uuid())
  fromAdvanceId  String
  fromAdvance    AdvancePayment @relation("AdvanceTransferFrom", fields: [fromAdvanceId], references: [id], onDelete: Cascade)
  toCustomerId   String
  toCustomer     Customer       @relation("AdvanceTransferToCustomer", fields: [toCustomerId], references: [id])
  toAdvanceId    String?
  transferAmount Float
  transferDate   DateTime       @default(now())
  note           String?
  // Who moved the money and from which customer (kept for a complete transfer history)
  fromCustomerId String?
  createdById    String?
  createdByName  String?

  @@index([fromAdvanceId, transferDate])
  @@index([toCustomerId, transferDate])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  price     Float
}

enum FinanceStatus {
  Pending
  Received
  Partial // some of the finance amount has been received, a balance remains
  Cancelled // the sale was cancelled: nothing is owed any more
}

model FinanceDetail {
  id                 String        @id @default(uuid())
  saleId             String        @unique
  sale               Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  financeCompany     String // company name as it was when the sale was made
  totalFinanceAmount Float // the finance (loan) amount the company owes the dealership
  downPaymentPaid    Float
  dealerCommission   Float?
  status             FinanceStatus @default(Pending)

  // Receivable tracking. Commission is NOT part of this (see CommissionSettlement).
  financeCompanyId String? // null only for legacy rows that could not be matched to a company
  company          FinanceCompany? @relation(fields: [financeCompanyId], references: [id], onDelete: Restrict)
  receivedAmount   Float           @default(0)
  balanceAmount    Float // totalFinanceAmount - receivedAmount (backfilled)
  expectedDate     DateTime?
  receivedAt       DateTime? // set when the balance reaches zero

  allocations FinanceReceiptAllocation[]

  @@index([financeCompanyId, status])
}

enum DMTStatus {
  Pending
  DocumentsCollected
  Processing
  Completed
  Cancelled // the sale was cancelled: no registration will happen
}

// අලුතින් එකතු කළ DMT Tracking Model එක
model DMTRegistration {
  id                 String            @id @default(uuid())
  saleId             String            @unique
  sale               Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  status             DMTStatus         @default(Pending)
  hasMTA2            Boolean           @default(false)
  hasNIC             Boolean           @default(false)
  hasPhotos          Boolean           @default(false)
  hasTIN             Boolean           @default(false)
  registeredNumber   String?
  registrationNumber String? // Actual bike license plate number once assigned (e.g. WP BHE-1234)
  isBookOk           Boolean           @default(false) // Vehicle Registration Book (පොත)
  isNumberPlateOk    Boolean           @default(false) // Number Plate
  isInsuranceOk      Boolean           @default(false) // Insurance Card/Policy
  lastNotifiedAt     DateTime? // Last SMS/WhatsApp notification timestamp
  numberPlateStatus  NumberPlateStatus @default(PENDING)
  // Set when the registration is moved to a new owner by an ownership transfer; null: the buyer of the sale
  ownerCustomerId    String?
  ownerCustomer      Customer?         @relation("DmtOwner", fields: [ownerCustomerId], references: [id], onDelete: SetNull)

  // Received documents: what the showroom gets back from RMV, and who it was handed to.
  // Registration certificate (CR / book): "received" = isBookOk.
  crReceivedAt        DateTime?
  crHandedOverAt      DateTime?
  crHandoverTarget    String? // CUSTOMER or FINANCE_COMPANY (finance sales: the absolute owner)
  crHandedToName      String?
  crHandedToNic       String?
  crHandoverReference String?
  crHandoverNotes     String?
  // Number plate: "received" = numberPlateStatus ISSUED.
  plateReceivedAt     DateTime?
  plateHandedOverAt   DateTime?
  plateHandedToName   String?
  plateHandoverNotes  String?
}

// ==========================================
// 4. After-Sales & Services
// ==========================================

enum ServiceType {
  Free
  Paid
  Warranty
}

model ServiceRecord {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId             String
  branch               Branch       @relation(fields: [branchId], references: [id])
  vehicleId            String
  vehicle              Vehicle      @relation(fields: [vehicleId], references: [id])
  customerId           String
  customer             Customer     @relation(fields: [customerId], references: [id])
  assignedTechnicianId String?
  assignedTechnician   User?        @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)

  serviceDate        DateTime    @default(now())
  inDate             DateTime    @default(now())
  outDate            DateTime?
  inMileage          String?
  nextServiceMileage String?
  serviceType        ServiceType
  description        String?
  totalCost          Float       @default(0)
  status             String      @default("PENDING")
  createdAt          DateTime    @default(now())
  serviceJob         ServiceJob?
}

model SparePart {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sku            String
  partNumber     String?
  price          Float
  stockQuantity  Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  serviceParts ServicePart[]

  @@unique([organizationId, sku])
  @@index([organizationId, name])
}

model ServiceJob {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceRecordId String        @unique
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)
  status          String        @default("COMPLETED")
  partsCost       Float         @default(0)
  totalCost       Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  parts ServicePart[]

  @@index([organizationId, createdAt])
}

model ServicePart {
  id           String     @id @default(uuid())
  serviceJobId String
  serviceJob   ServiceJob @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  sparePartId  String
  sparePart    SparePart  @relation(fields: [sparePartId], references: [id], onDelete: Restrict)
  quantity     Int
  unitPrice    Float
  totalPrice   Float
  createdAt    DateTime   @default(now())

  @@unique([serviceJobId, sparePartId])
  @@index([sparePartId])
}

model Payment {
  id            String         @id @default(uuid())
  saleId        String?
  sale          Sale?          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  grnId         String?
  grn           GRN?           @relation(fields: [grnId], references: [id], onDelete: Cascade)
  amount        Float
  paymentMethod PaymentMethod?
  chequeNumber  String?
  bankName      String?
  chequeDate    DateTime?
  dueDate       DateTime?
  chequeStatus  ChequeStatus?
  status        PaymentStatus  @default(Pending)
  createdAt     DateTime       @default(now())
}

model TestRide {
  id             String         @id @default(uuid())
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleModelId String
  vehicleModel   VehicleModel   @relation(fields: [vehicleModelId], references: [id])
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch         @relation(fields: [branchId], references: [id])
  scheduledDate  DateTime
  timeSlot       String
  status         TestRideStatus @default(BOOKED)
  createdAt      DateTime       @default(now())

  @@index([organizationId, scheduledDate])
  @@index([branchId, scheduledDate])
}

// ==========================================
// Commission settlement, bank deposits
// ==========================================

enum SettlementType {
  FINANCE
  INSURANCE
  RMV
}

enum SettlementStatus {
  PENDING
  SETTLED
  CANCELLED // the sale was cancelled: this commission is void
}

// Whether a commission has actually been received/paid out. One row per sale and commission type;
// a missing row means PENDING. Owner-only (see app/actions/commission-settlement.ts).
model CommissionSettlement {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleId         String
  sale           Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  type           SettlementType
  status         SettlementStatus @default(PENDING)
  amount         Float            @default(0) // snapshot at settlement time (RMV: entered by the owner)
  settledAt      DateTime?
  reference      String?
  updatedById    String?
  updatedAt      DateTime         @updatedAt
  createdAt      DateTime         @default(now())

  @@unique([saleId, type])
  @@index([organizationId, type, status])
}

model BankAccount {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankName       String
  accountNumber  String
  accountName    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  deposits BankDeposit[]

  @@unique([organizationId, accountNumber])
}

// Cash from a day's sales paid into a bank account.
model BankDeposit {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  bankAccountId  String
  bankAccount    BankAccount  @relation(fields: [bankAccountId], references: [id])
  depositDate    DateTime // Colombo calendar day the cash belongs to (stored at UTC midnight of that date)
  cashSalesTotal Float // snapshot of that day's cash sales for the branch when recorded (reference only)
  depositAmount  Float
  slipNumber     String
  description    String?
  createdById    String
  createdByName  String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, bankAccountId, slipNumber])
  @@index([organizationId, depositDate])
  @@index([branchId, depositDate])
}

// ==========================================
// Finance (leasing) receivables
// ==========================================

enum FinanceReceiptMethod {
  BankTransfer
  CHEQUE
  Cash
}

enum FinanceReceiptStatus {
  COMPLETED // applied to the sales' balances
  PENDING // cheque not cleared yet: allocations are only reserved, balances unchanged
  REVERSED // voided or bounced after being applied
}

// Money received from a finance company, allocated across that company's sales.
model FinanceReceipt {
  id               String         @id @default(uuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?        @relation(fields: [branchId], references: [id])
  financeCompanyId String
  financeCompany   FinanceCompany @relation(fields: [financeCompanyId], references: [id])

  receiptNumber String // FR-00001 per dealership
  amount        Float
  method        FinanceReceiptMethod
  status        FinanceReceiptStatus @default(COMPLETED)
  receiptDate   DateTime             @default(now())
  referenceNo   String?
  notes         String?
  createdById   String
  createdByName String
  createdAt     DateTime             @default(now())
  appliedAt     DateTime? // when the allocations were applied to the balances
  reversedAt    DateTime?

  allocations    FinanceReceiptAllocation[]
  incomingCheque IncomingCheque?

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, receiptDate])
  @@index([financeCompanyId, status])
}

model FinanceReceiptAllocation {
  id              String         @id @default(uuid())
  receiptId       String
  receipt         FinanceReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  financeDetailId String
  financeDetail   FinanceDetail  @relation(fields: [financeDetailId], references: [id])
  amount          Float
  createdAt       DateTime       @default(now())

  @@index([receiptId])
  @@index([financeDetailId])
}

enum IncomingChequeStatus {
  RECEIVED
  PRESENTED
  CLEARED
  BOUNCED
}

// A cheque received from a finance company. Kept apart from the supplier Cheque model, which is
// tied to supplier payments; the lifecycle mirrors it (PRESENTED then CLEARED or BOUNCED).
model IncomingCheque {
  id               String         @id @default(uuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  financeCompanyId String
  financeCompany   FinanceCompany @relation(fields: [financeCompanyId], references: [id])
  receiptId        String         @unique
  receipt          FinanceReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  chequeNumber String
  bankName     String
  amount       Float
  chequeDate   DateTime
  status       IncomingChequeStatus @default(RECEIVED)
  presentedAt  DateTime?
  clearedAt    DateTime?
  bouncedAt    DateTime?
  bounceReason String?
  createdAt    DateTime             @default(now())

  events IncomingChequeEvent[]

  @@index([organizationId, status])
}

model IncomingChequeEvent {
  id         String                @id @default(uuid())
  chequeId   String
  cheque     IncomingCheque        @relation(fields: [chequeId], references: [id], onDelete: Cascade)
  fromStatus IncomingChequeStatus?
  toStatus   IncomingChequeStatus
  note       String?
  userId     String?
  createdAt  DateTime              @default(now())

  @@index([chequeId])
}

// ==========================================
// INTER-BRANCH STOCK TRANSFERS
// ==========================================

enum StockTransferStatus {
  IN_TRANSIT // dispatched: the bikes are InTransit and not in either branch's stock
  RECEIVED // received at the destination: the bikes are AVAILABLE there
  CANCELLED // cancelled before receipt: the bikes are back in the source branch
}

// A batch of bikes moved from one branch to another. The bikes keep their GRN, so inventory aging
// still counts from the original received date.
model StockTransfer {
  id               String              @id @default(uuid())
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transferNumber   String // ST-00001 per dealership
  fromBranchId     String
  fromBranch       Branch              @relation("StockTransferFrom", fields: [fromBranchId], references: [id])
  toBranchId       String
  toBranch         Branch              @relation("StockTransferTo", fields: [toBranchId], references: [id])
  status           StockTransferStatus @default(IN_TRANSIT)
  notes            String?
  dispatchedById   String
  dispatchedByName String
  dispatchedAt     DateTime            @default(now())
  receivedById     String?
  receivedByName   String?
  receivedAt       DateTime?
  cancelledById    String?
  cancelledByName  String?
  cancelledAt      DateTime?
  cancelReason     String?

  items StockTransferItem[]

  @@unique([organizationId, transferNumber])
  @@index([organizationId, status])
  @@index([fromBranchId, status])
  @@index([toBranchId, status])
}

model StockTransferItem {
  id         String        @id @default(uuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle       @relation(fields: [vehicleId], references: [id])

  @@unique([transferId, vehicleId])
  @@index([vehicleId])
}

// Freebies the owner offers with a sale (helmet, carpet...). Managed in Owner Settings; only active items are
// offered on NEW sales. A sale keeps the item NAME as a snapshot (Sale.freeItems and SaleFreeItem.itemName).
model FreeItem {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  saleLinks SaleFreeItem[]

  @@unique([organizationId, name])
}

// Which FreeItem a sale used (so an item that was ever used cannot be deleted); the name stays as it was.
model SaleFreeItem {
  id         String    @id @default(uuid())
  saleId     String
  sale       Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  freeItemId String?
  freeItem   FreeItem? @relation(fields: [freeItemId], references: [id], onDelete: SetNull)
  itemName   String

  @@index([saleId])
  @@index([freeItemId])
}

// An office / branch location of a finance company or an insurance company (not a person: see FinanceOfficer /
// InsuranceOfficer for the officers). One table for both kinds: exactly one of the two company ids is set
// (enforced by a CHECK constraint in the migration). A sale keeps the office NAME as a snapshot.
model CompanyOffice {
  id                 String            @id @default(uuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  financeCompanyId   String?
  financeCompany     FinanceCompany?   @relation(fields: [financeCompanyId], references: [id], onDelete: Cascade)
  insuranceCompanyId String?
  insuranceCompany   InsuranceCompany? @relation(fields: [insuranceCompanyId], references: [id], onDelete: Cascade)
  name               String
  address            String?
  phone              String?
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  financeSales   Sale[] @relation("SaleFinanceOffice")
  insuranceSales Sale[] @relation("SaleInsuranceOffice")

  @@unique([financeCompanyId, name])
  @@unique([insuranceCompanyId, name])
  @@index([organizationId])
}

// A change of owner of a SOLD bike. The original sale (prices, commissions, receivables) is never touched: its
// customer stays the buyer. Current owner = toCustomer of the latest transfer, else the buyer of the sale.
model VehicleOwnershipTransfer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slipNumber     String       @unique
  vehicleId      String
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  saleId         String? // the sale the bike was sold in (for reference only)
  fromCustomerId String
  fromCustomer   Customer     @relation("OwnershipTransferFrom", fields: [fromCustomerId], references: [id], onDelete: Restrict)
  toCustomerId   String
  toCustomer     Customer     @relation("OwnershipTransferTo", fields: [toCustomerId], references: [id], onDelete: Restrict)
  transferDate   DateTime // Colombo calendar day, stored at UTC midnight of that date
  reason         String?      @db.Text
  transferFee    Float        @default(0)

  // Document checklist
  docTransferForm     Boolean @default(false) // transfer form signed
  docNicCopies        Boolean @default(false) // NIC copies of both parties
  docRegistrationBook Boolean @default(false) // original registration document (if registered)

  // DMT / RMV registration moved to the new owner (the previous DMT owner is kept here)
  dmtOwnerUpdated         Boolean @default(false)
  dmtPreviousOwnerId      String? // null: the buyer of the sale was the registration owner
  // Finance sale: the staff member confirmed the leasing company may still hold ownership
  financeWarningConfirmed Boolean @default(false)

  createdById   String
  createdByName String
  createdAt     DateTime @default(now())

  @@index([vehicleId, transferDate])
  @@index([fromCustomerId])
  @@index([toCustomerId])
  @@index([organizationId, transferDate])
}

// ---------------------------------------------------------------------------------------------
// Supplier monthly target commission: an incentive the SUPPLIER pays the dealership per unit sold,
// based on how much of the monthly target was achieved. Dealership income, owner only.
// ---------------------------------------------------------------------------------------------

/**
 * One step of the commission ladder: from this achievement % upwards, the supplier pays this much per unit.
 */
model SupplierCommissionSlab {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromPercent    Float // minimum achievement % for this slab
  amountPerUnit  Float // commission per unit sold (LKR)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, fromPercent])
}

/**
 * Target number of bikes a supplier should sell through the dealership in one month ("YYYY-MM").
 */
model SupplierMonthlyTarget {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  month          String // "YYYY-MM"
  targetUnits    Int
  updatedAt      DateTime     @updatedAt

  @@unique([supplierId, month])
  @@index([organizationId, month])
}

/**
 * A closed month: a snapshot of the figures and the slabs used, so later changes never alter it.
 */
model SupplierCommissionMonth {
  id             String                   @id @default(uuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  month          String // "YYYY-MM"
  closedAt       DateTime                 @default(now())
  closedById     String?
  closedByName   String?
  slabsSnapshot  Json // [{ fromPercent, amountPerUnit }] in force when the month was closed
  lines          SupplierCommissionLine[]

  @@unique([organizationId, month])
}

/**
 * One supplier's figures in a closed month. supplierName is a snapshot; no FK so history survives supplier deletion.
 */
model SupplierCommissionLine {
  id                 String                  @id @default(uuid())
  monthId            String
  closedMonth        SupplierCommissionMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  supplierId         String
  supplierName       String
  targetUnits        Int
  unitsSold          Int
  achievementPercent Float
  slabFromPercent    Float? // the slab that applied (null = none)
  amountPerUnit      Float                   @default(0)
  totalCommission    Float                   @default(0)

  @@unique([monthId, supplierId])
}

/**
 * The supplier paid this month's commission to the dealership (works for open and closed months).
 */
model SupplierCommissionReceipt {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplierName   String
  month          String // "YYYY-MM"
  amount         Float // commission total when it was marked received
  receivedAt     DateTime
  reference      String?
  recordedById   String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, supplierId, month])
}

// ---------------------------------------------------------------------------------------------
// Delivery Orders (finance / leasing sales): the finance company approves and issues a DO, the dealer delivers
// against it, then submits DO + invoice + documents as a claim. PAID is not stored: it is derived from the
// finance receivable being fully received (FinanceDetail.status), so a reversed receipt reverts it automatically.
// ---------------------------------------------------------------------------------------------

enum DeliveryOrderStatus {
  AWAITING_DO
  DO_RECEIVED
  DELIVERED
  CLAIM_SUBMITTED
  CANCELLED // the sale was cancelled
}

model DeliveryOrder {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleId         String              @unique
  sale           Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  status         DeliveryOrderStatus @default(AWAITING_DO)

  doNumber           String?
  doNumberInternal   Boolean   @default(false) // true: an internal reference (DO-0001), not the finance company's number
  doDate             DateTime?
  financeCompanyId   String?
  financeCompanyName String
  financeOfficeName  String?
  doAmount           Float?
  expiryDate         DateTime?
  notes              String?
  scanUrl            String? // reserved for a scanned copy (storage not decided yet)
  scanName           String?
  stageChangedAt     DateTime  @default(now()) // start of the current stage, for aging

  // Delivered before the DO was recorded (owner / OVERRIDE_DO_DELIVERY, reason required)
  deliveryOverrideReason   String?
  deliveryOverriddenByName String?

  claimSubmittedAt     DateTime?
  claimReference       String?
  claimChecklist       Json? // { deliveryOrder, invoice, customerNic, mtaForms, registrationDocuments }
  claimSubmittedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
}
