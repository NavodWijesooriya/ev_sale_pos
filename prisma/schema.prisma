generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. Platform & Tenant Management
// ==========================================

enum PlatformRole {
  PlatformAdmin
  Support
}

model PlatformUser {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  role         PlatformRole
  createdAt    DateTime     @default(now())
}

enum SubscriptionPlan {
  Free
  Basic
  Pro
  Enterprise
}

enum SubscriptionStatus {
  Active
  Suspended
}

model Organization {
  id                    String             @id @default(uuid())
  businessName          String
  domain                String?            @unique
  subdomain             String?            @unique
  phone                 String?
  logoUrl               String?
  subscriptionPlan      SubscriptionPlan   @default(Free)
  subscriptionStatus    SubscriptionStatus @default(Active)
  expiryDate            DateTime?
  staffCanManageCatalog Boolean            @default(false)
  createdAt             DateTime           @default(now())

  users          User[]
  branches       Branch[]
  suppliers      Supplier[]
  vehicleModels  VehicleModel[]
  vehicles       Vehicle[]
  grns           GRN[]
  customers      Customer[]
  sales          Sale[]
  serviceRecords ServiceRecord[]
  testRides      TestRide[]
  customDomain   String?         @unique
}

enum UserRole {
  OrgAdmin
  BranchManager
  SalesRep
  Cashier
  Technician
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  name           String
  email          String       @unique
  passwordHash   String
  role           UserRole
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  sales            Sale[]          @relation("SoldBy")
  assignedServices ServiceRecord[] @relation("AssignedTechnician")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  location       String?
  contactNumber  String?
  createdAt      DateTime     @default(now())

  users          User[]
  vehicles       Vehicle[]
  grns           GRN[]
  sales          Sale[]
  serviceRecords ServiceRecord[]
  testRides      TestRide[]
}

// ==========================================
// 2. Inventory & Procurement
// ==========================================

model Supplier {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactPerson  String?
  phone          String?
  email          String?

  grns GRN[]
}

model VehicleModel {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand           String
  modelName       String
  imageUrl        String?
  motorPower      String? // e.g., "2000W"
  batteryCapacity String? // e.g., "60V 32Ah"
  rangePerCharge  String? // e.g., "120km"
  range           String? // backward compatibility alias
  topSpeed        String? // e.g., "55 km/h"
  chargingTime    String? // e.g., "4-6 Hours"
  defaultPrice    Float
  minDownPayment  Float?

  vehicles  Vehicle[]
  testRides TestRide[]
}

enum VehicleStatus {
  InStock
  Sold
  InTransit
  Reserved
}

model Vehicle {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id])

  chassisNumber       String        @unique
  motorNumber         String?
  batterySerialNumber String?       @unique // අලුතින් එකතු කළ කොටස
  warrantyPeriod      String? // අලුතින් එකතු කළ කොටස (උදා: 3 Years)
  color               String?
  status              VehicleStatus @default(InStock)
  purchasePrice       Float
  motorPower          String? // e.g., "2000W"
  batteryCapacity     String? // e.g., "60V 32Ah"
  rangePerCharge      String? // e.g., "120km"
  topSpeed            String? // e.g., "55 km/h"
  chargingTime        String? // e.g., "4-6 Hours"
  createdAt           DateTime      @default(now())

  grnItems       GRNItem[]
  saleItems      SaleItem[]
  serviceRecords ServiceRecord[]
}

model GRN {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id])

  grnNumber    String
  totalAmount  Float
  receivedDate DateTime @default(now())

  items    GRNItem[]
  payments Payment[]
}

model GRNItem {
  id        String  @id @default(uuid())
  grnId     String
  grn       GRN     @relation(fields: [grnId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  unitPrice Float
}

// ==========================================
// 3. Sales, Finance, Customers & DMT
// ==========================================

model Customer {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       CustomerCategory @default(CRM)
  name           String
  phone          String
  email          String?
  nic            String?
  address        String?
  crn            String?          @unique

  sales          Sale[]
  serviceRecords ServiceRecord[]
  testRides      TestRide[]
}

enum CustomerCategory {
  DIRECT
  CRM
}

enum PaymentMethod {
  Cash
  Card
  BankTransfer
  Finance
  SplitPayment
  CHEQUE
}

enum ChequeStatus {
  PENDING
  CLEARED
  BOUNCED
}

enum PaymentStatus {
  Pending
  Paid
  PartiallyPaid
}

enum TestRideStatus {
  BOOKED
  COMPLETED
  CANCELLED
}

enum NumberPlateStatus {
  PENDING
  PROCESSING
  ISSUED
}

model Sale {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  userId         String
  soldBy         User         @relation("SoldBy", fields: [userId], references: [id])

  saleDate          DateTime      @default(now())
  totalAmount       Float
  discount          Float         @default(0) // අලුතින් එකතු කළ කොටස
  additionalCharges Float         @default(0) // අලුතින් එකතු කළ කොටස
  deliveryDate      DateTime? // අලුතින් එකතු කළ කොටස
  paymentMethod     PaymentMethod
  status            String        @default("Completed")

  items           SaleItem[]
  financeDetail   FinanceDetail?
  dmtRegistration DMTRegistration? // අලුතින් එකතු කළ කොටස
  payments        Payment[]
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  price     Float
}

enum FinanceStatus {
  Pending
  Received
}

model FinanceDetail {
  id                 String        @id @default(uuid())
  saleId             String        @unique
  sale               Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  financeCompany     String
  totalFinanceAmount Float
  downPaymentPaid    Float
  dealerCommission   Float?
  status             FinanceStatus @default(Pending)
}

enum DMTStatus {
  Pending
  DocumentsCollected
  Processing
  Completed
}

// අලුතින් එකතු කළ DMT Tracking Model එක
model DMTRegistration {
  id                String            @id @default(uuid())
  saleId            String            @unique
  sale              Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  status            DMTStatus         @default(Pending)
  hasMTA2           Boolean           @default(false)
  hasNIC            Boolean           @default(false)
  hasPhotos         Boolean           @default(false)
  hasTIN            Boolean           @default(false)
  registeredNumber  String?
  numberPlateStatus NumberPlateStatus @default(PENDING)
}

// ==========================================
// 4. After-Sales & Services
// ==========================================

enum ServiceType {
  Free
  Paid
  Warranty
}

model ServiceRecord {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId             String
  branch               Branch       @relation(fields: [branchId], references: [id])
  vehicleId            String
  vehicle              Vehicle      @relation(fields: [vehicleId], references: [id])
  customerId           String
  customer             Customer     @relation(fields: [customerId], references: [id])
  assignedTechnicianId String?
  assignedTechnician   User?        @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)

  serviceDate        DateTime    @default(now())
  nextServiceDueDate DateTime?
  serviceType        ServiceType
  description        String?
  totalCost          Float       @default(0)
  status             String      @default("PENDING")
  createdAt          DateTime    @default(now())
}

model Payment {
  id            String         @id @default(uuid())
  saleId        String?
  sale          Sale?          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  grnId         String?
  grn           GRN?           @relation(fields: [grnId], references: [id], onDelete: Cascade)
  amount        Float
  paymentMethod PaymentMethod?
  chequeNumber  String?
  bankName      String?
  chequeDate    DateTime?
  dueDate       DateTime?
  chequeStatus  ChequeStatus?
  status        PaymentStatus  @default(Pending)
  createdAt     DateTime       @default(now())
}

model TestRide {
  id             String         @id @default(uuid())
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleModelId String
  vehicleModel   VehicleModel   @relation(fields: [vehicleModelId], references: [id])
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch         @relation(fields: [branchId], references: [id])
  scheduledDate  DateTime
  timeSlot       String
  status         TestRideStatus @default(BOOKED)
  createdAt      DateTime       @default(now())

  @@index([organizationId, scheduledDate])
  @@index([branchId, scheduledDate])
}
